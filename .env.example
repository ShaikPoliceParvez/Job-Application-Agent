# ============================================================
# Job Application Agent - environment variables
# Copy this file to .env and fill in the values you need.
# Never commit the real .env file.
# ============================================================

APP_ENV=local

# ---- LLM configuration ----
# Production OCR uses the external API; local development can use PaddleOCR.
LLM_MODE=cloud
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_MODEL=your_cloud_model_here

# Set LLM_MODE=local and use a locally pulled model for offline development.
# OLLAMA_BASE_URL=http://localhost:11434
MODEL_OCR=PP-OCRv6
MODEL_VISION=gemma3:4b

# ---- Email sending ----
# mock  -> never actually sends, just builds + logs the MIME message
# gmail -> sends for real via the Gmail API
EMAIL_SEND_MODE=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/gmail/callback
GOOGLE_TOKEN_PATH=data/gmail_token.json

# ---- Appwrite Storage (optional locally, required for persistent deploys) ----
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_BUCKET_ID=
APPWRITE_RESUME_FILE_ID=
APPWRITE_RESUME_FILENAME=resume.pdf

# ---- Google OAuth (required only once EMAIL_SEND_MODE=gmail is used) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/gmail/callback

# ---- Paths ----
RESUME_DIRECTORY=data/resumes
SCREENSHOT_DIRECTORY=data/screenshots

# ---- OCR ----
OCR_MODE=local
OCR_CONFIDENCE_THRESHOLD=0.80
OCR_WARMUP_ON_STARTUP=false
OCR_API_URL=
OCR_API_KEY=
OCR_API_TIMEOUT_SECONDS=60

# Comma-separated browser origins allowed to call the backend.
CORS_ALLOWED_ORIGINS=http://localhost:8000,https://job-application-agent.appwrite.network

# ---- Database ----
DATABASE_URL=sqlite:///applications.db
